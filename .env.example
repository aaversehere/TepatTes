# Konfigurasi Supabase PostgreSQL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres"

# Kunci Enkripsi AES-256-GCM At-Rest (32-byte hex = 64 karakter hex)
AES_ENCRYPTION_KEY="4f8b2e9a1c7d6f3e5a0b8c9d2e1f4a7b6c5d8e9f0a1b2c3d4e5f6a7b8c9d0e1f"

# Konfigurasi Server-Side OpenAI LLM (Tidak pernah dikirim ke klien)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini-2024-07-18"
